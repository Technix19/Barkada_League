PORT=3001
# Supabase PostgreSQL connection string (server only, never committed)
DATABASE_URL=postgresql://YOUR_SUPABASE_CONNECTION_STRING
# Supabase project URL and publishable API key (NOT the service-role key).
# Used by Express to validate Bearer tokens at /auth/v1/user.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Comma-separated list of allowed browser origins. Set this on Render.
FRONTEND_ORIGIN=http://localhost:5173,https://barkada-league.vercel.app
